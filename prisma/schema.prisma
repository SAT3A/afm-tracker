datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Persona {
  id          String   @id @default(uuid())
  name        String
  niches      Json     // Array of strings, e.g. ["gym", "outfit", "parfum"]
  description String?  @db.Text
  avatarUrl   String?  @map("avatar_url")
  platforms   Json?    // Accounts on FB, IG, etc.
  status      String   @default("active") // active / inactive
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  distributions Distribution[]
  contents      Content[]
  schedules     Schedule[]

  @@map("personas")
}

model Product {
  id             String   @id @default(uuid())
  brand          String
  category       String
  productName    String   @map("product_name")
  variant        String?
  affiliateLink  String   @map("affiliate_link")
  originalLink   String?  @map("original_link")
  price          Decimal  @db.Decimal(12, 2)
  commissionRate Decimal  @map("commission_rate") @db.Decimal(5, 2) // e.g. 10.00 for 10%
  tags           String[] @default([])
  campaign       String?
  notes          String?  @db.Text
  status         String   @default("active") // active / expired / paused
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  distributionItems DistributionItem[]
  contentProducts   ContentProduct[]

  @@map("products")
}

model Platform {
  id               String   @id @default(uuid())
  platformType     String   @map("platform_type") // facebook / instagram / threads / tiktok / other
  name             String
  url              String?
  category         String   @default("Sebar link shopee affiliate")
  requiresApproval Boolean  @default(false) @map("requires_approval")
  notes            String?  @db.Text
  status           String   @default("active") // active / inactive
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  distributions    Distribution[]

  @@map("platforms")
}

model Distribution {
  id               String   @id @default(uuid())
  platformId       String   @map("platform_id")
  personaId        String   @map("persona_id")
  distributionType String   @default("comment") @map("distribution_type") // post / comment
  postUrl          String   @map("post_url")
  postedAt         DateTime @default(now()) @map("posted_at")
  status           String   @default("posted") // posted / pending_approval / approved / deleted / rejected
  campaign         String?
  notes            String?  @db.Text
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  platform         Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)
  persona          Persona  @relation(fields: [personaId], references: [id], onDelete: Cascade)
  items            DistributionItem[]
  engagements      DistributionEngagement[]

  @@map("distributions")
}

model DistributionItem {
  id             String       @id @default(uuid())
  distributionId String       @map("distribution_id")
  productId      String       @map("product_id")

  distribution   Distribution @relation(fields: [distributionId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([distributionId, productId])
  @@map("distribution_items")
}

model DistributionEngagement {
  id             String       @id @default(uuid())
  distributionId String       @map("distribution_id")
  likesCount     Int          @default(0) @map("likes_count")
  viewsCount     Int          @default(0) @map("views_count")
  sharesCount    Int          @default(0) @map("shares_count")
  clicksCount    Int          @default(0) @map("clicks_count")
  ordersCount    Int?         @map("orders_count")
  capturedAt     DateTime     @default(now()) @map("captured_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  distribution   Distribution @relation(fields: [distributionId], references: [id], onDelete: Cascade)

  @@map("distribution_engagements")
}

model Content {
  id          String   @id @default(uuid())
  personaId   String   @map("persona_id")
  title       String
  contentType String   @map("content_type") // shopee_video / fb_reels / ig_reels / tiktok / other
  platformUrl String   @map("platform_url")
  campaign    String?
  publishedAt DateTime @default(now()) @map("published_at")
  notes       String?  @db.Text
  status      String   @default("published") // published / draft / deleted
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  persona     Persona  @relation(fields: [personaId], references: [id], onDelete: Cascade)
  products    ContentProduct[]
  metrics     ContentMetric[]

  @@map("contents")
}

model ContentProduct {
  id        String  @id @default(uuid())
  contentId String  @map("content_id")
  productId String  @map("product_id")

  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([contentId, productId])
  @@map("content_products")
}

model ContentMetric {
  id            String   @id @default(uuid())
  contentId     String   @map("content_id")
  viewsCount    Int      @default(0) @map("views_count")
  likesCount    Int      @default(0) @map("likes_count")
  commentsCount Int      @default(0) @map("comments_count")
  sharesCount   Int      @default(0) @map("shares_count")
  savesCount    Int?     @map("saves_count")
  clicksCount   Int?     @map("clicks_count")
  capturedAt    DateTime @default(now()) @map("captured_at")
  createdAt     DateTime @default(now()) @map("created_at")

  content       Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@map("content_metrics")
}

model Schedule {
  id             String   @id @default(uuid())
  personaId      String?  @map("persona_id")
  title          String
  scheduleType   String   @default("one_time") @map("schedule_type") // one_time / recurring
  recurrenceRule String?  @map("recurrence_rule")
  scheduledAt    DateTime @map("scheduled_at")
  status         String   @default("scheduled") // scheduled / reminded / posted / missed
  notes          String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  persona        Persona? @relation(fields: [personaId], references: [id], onDelete: SetNull)

  @@map("schedules")
}
